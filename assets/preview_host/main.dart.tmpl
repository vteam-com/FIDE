// Generated by FIDE: the host rendering the widget previews of the file open
// in FIDE's editor. FIDE rewrites this folder; don't edit it.
//
// FIDE runs it headless on the flutter-tester device and talks to it over a
// local WebSocket: FIDE sends the render settings and the pointer events of
// the Preview panel, the host sends each preview's frames back as PNG.
// ignore_for_file: type=lint

import 'dart:async';
import 'dart:convert';
import 'dart:io';
import 'dart:typed_data';
import 'dart:ui' as ui;

import 'package:flutter/cupertino.dart';
import 'package:flutter/gestures.dart';
import 'package:flutter/material.dart';
import 'package:flutter/rendering.dart';
import 'package:flutter/scheduler.dart';
import 'package:flutter/widget_previews.dart';

import 'previews.dart' as registry;

/// The port of FIDE's WebSocket server.
const int _port = int.fromEnvironment('FIDE_PREVIEW_PORT');

/// Bytes before the PNG in a frame message: generation, index, logical
/// width and height, and the sizing flags, 4 bytes each.
const int _frameHeaderBytes = 20;

/// Sizing flag: the preview sets no width and fills the panel's.
const int _widthFollowsPanel = 1;

/// Sizing flag: the preview sets no height and has no natural one.
const int _heightIsFallback = 2;

/// Sizing flag: FIDE set a height other than the annotation's.
const int _heightIsAdjusted = 4;

/// Sizing flag: FIDE set a width other than the annotation's.
const int _widthIsAdjusted = 8;

/// Sizing flag: the width is Auto, set by neither the annotation nor FIDE.
const int _widthIsAuto = 16;

/// Sizing flag: the height is Auto, set by neither the annotation nor FIDE.
const int _heightIsAuto = 32;

/// How close to the panel's width a preview's must be to fill it.
const double _fillTolerance = 0.5;

/// Least time between two frames of an animating preview.
const Duration _frameInterval = Duration(milliseconds: 33);

late final WebSocket _socket;

/// The render settings FIDE sent last.
final _HostSettings _settings = _HostSettings();

/// The host, for the WebSocket messages to reach it.
final GlobalKey<_PreviewHostState> _hostKey = GlobalKey<_PreviewHostState>();

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  _socket = await WebSocket.connect('ws://127.0.0.1:$_port');
  FlutterError.onError = (details) => _send({
    'type': 'log',
    'message': details.toString(),
  });
  _socket.listen(_onMessage, onDone: () => exit(0));
  runApp(_PreviewHost(key: _hostKey));
}

void _send(Map<String, Object?> message) => _socket.add(jsonEncode(message));

void _onMessage(Object? data) {
  if (data is! String) return;
  final message = jsonDecode(data) as Map<String, Object?>;
  final host = _hostKey.currentState;
  switch (message['type']) {
    case 'settings':
      _settings.update(message);
      host?.settingsChanged();
    case 'pointer':
      host?.dispatchPointer(message);
    case 'size':
      host?.setSize(message);
  }
}

/// How FIDE wants the previews rendered.
class _HostSettings {
  double pixelRatio = 2;
  double maxWidth = 400;
  double maxHeight = 600;
  double fallbackHeight = 300;

  /// Brightness forced on every preview; null to use each preview's own.
  Brightness? brightness;

  /// Brightness of the previews that don't set theirs: FIDE's theme.
  Brightness fallbackBrightness = Brightness.light;

  void update(Map<String, Object?> message) {
    pixelRatio = (message['pixelRatio'] as num?)?.toDouble() ?? pixelRatio;
    maxWidth = (message['maxWidth'] as num?)?.toDouble() ?? maxWidth;
    maxHeight = (message['maxHeight'] as num?)?.toDouble() ?? maxHeight;
    fallbackHeight =
        (message['fallbackHeight'] as num?)?.toDouble() ?? fallbackHeight;
    brightness = _brightness(message['brightness']);
    fallbackBrightness =
        _brightness(message['fallbackBrightness']) ?? fallbackBrightness;
  }

  static Brightness? _brightness(Object? name) => switch (name) {
    'light' => Brightness.light,
    'dark' => Brightness.dark,
    _ => null,
  };
}

/// One preview: an annotation applied to a preview function.
class _Entry {
  _Entry(
    this.function,
    this.annotation,
    this.line,
    this.preview,
    this.build,
    this.id,
    this.key,
  );

  final String function;

  /// The position of the entry's annotation among its function's.
  final int annotation;
  final int line;
  final Preview preview;
  final Object? Function() build;

  /// Function, annotation and position: the same across hot reloads.
  final String id;

  /// Kept across hot reloads, so the preview keeps its state.
  final GlobalKey key;
}

class _PreviewHost extends StatefulWidget {
  const _PreviewHost({super.key});

  @override
  State<_PreviewHost> createState() => _PreviewHostState();
}

class _PreviewHostState extends State<_PreviewHost> {
  List<_Entry> _entries = const [];

  /// The key of each preview by function and position, reused by the
  /// next list.
  Map<String, GlobalKey> _keys = {};

  /// Bumped each time the previews are listed again, so FIDE drops the
  /// frames of the previous list.
  int _generation = 0;

  /// The width FIDE set for a preview, by entry id, null for Auto; kept
  /// across hot reloads, like the previews' state.
  final Map<String, double?> _widths = {};

  /// The height FIDE set for a preview, like [_widths].
  final Map<String, double?> _heights = {};

  /// The entries to capture after the next frame.
  final Set<int> _dirty = {};

  /// The preview last touched, captured after every frame while it
  /// animates.
  int? _active;

  /// Hit test of each pointer down, for its moves and its up.
  final Map<int, HitTestResult> _hits = {};
  int _nextPointer = 1;
  int? _pointer;

  bool _capturing = false;
  bool _captureAgain = false;
  DateTime _lastCapture = DateTime.fromMillisecondsSinceEpoch(0);

  @override
  void initState() {
    super.initState();
    _collect();
    SchedulerBinding.instance.addPersistentFrameCallback(
      (_) => SchedulerBinding.instance.addPostFrameCallback((_) => _capture()),
    );
  }

  @override
  void reassemble() {
    // A hot reload: the registry may list other previews
    super.reassemble();
    _collect();
  }

  /// Lists the previews of the registry and tells FIDE.
  void _collect() {
    final entries = <_Entry>[];
    final keys = <String, GlobalKey>{};
    final annotations = <String, int>{};
    for (final declaration in registry.fidePreviews()) {
      final annotation = annotations[declaration.function] =
          (annotations[declaration.function] ?? -1) + 1;
      final List<Preview> previews;
      try {
        final annotation = declaration.annotation();
        previews = switch (annotation) {
          MultiPreview() => annotation.transform(),
          Preview() => [annotation.transform()],
          _ => const [],
        };
      } catch (error) {
        _send({'type': 'log', 'message': '${declaration.function}: $error'});
        continue;
      }
      for (final (position, preview) in previews.indexed) {
        final id = '${declaration.function}#$annotation#$position';
        final key = keys[id] = _keys[id] ?? GlobalKey();
        entries.add(
          _Entry(
            declaration.function,
            annotation,
            declaration.line,
            preview,
            declaration.build,
            id,
            key,
          ),
        );
      }
    }
    _entries = entries;
    _keys = keys;
    // A size the code now sets, such as after Fix Size, is no longer FIDE's
    for (final entry in entries) {
      final size = entry.preview.size;
      _forgetIfCoded(_widths, entry.id, _finite(size?.width));
      _forgetIfCoded(_heights, entry.id, _finite(size?.height));
    }
    _generation++;
    _active = null;
    _send({
      'type': 'previews',
      'generation': _generation,
      'items': [
        for (final entry in entries)
          {
            'function': entry.function,
            'annotation': entry.annotation,
            'line': entry.line,
            'name': entry.preview.name,
            'group': entry.preview.group,
          },
      ],
    });
    _markAllDirty();
  }

  /// Lays out the preview at the message's index with the message's
  /// `width` or `height` (its `axis`) at its `value`, Auto when null.
  void setSize(Map<String, Object?> message) {
    final index = message['index'] as int;
    if (index >= _entries.length) return;
    final sizes = message['axis'] == 'width' ? _widths : _heights;
    setState(() {
      sizes[_entries[index].id] = (message['value'] as num?)?.toDouble();
      _dirty.add(index);
    });
  }

  /// Forgets the length FIDE set in [lengths] for entry [id] once it is
  /// the [coded] one.
  static void _forgetIfCoded(
    Map<String, double?> lengths,
    String id,
    double? coded,
  ) {
    if (lengths.containsKey(id) && lengths[id] == coded) lengths.remove(id);
  }

  /// The length FIDE set in [lengths] for entry [id], else the [coded] one.
  static double? _lengthOf(
    Map<String, double?> lengths,
    String id,
    double? coded,
  ) => lengths.containsKey(id) ? lengths[id] : coded;

  /// [length] when it is finite; null, for Auto, otherwise.
  static double? _finite(double? length) =>
      length != null && length.isFinite ? length : null;

  void settingsChanged() {
    setState(_markAllDirty);
  }

  void _markAllDirty() {
    _dirty.addAll(List.generate(_entries.length, (index) => index));
    SchedulerBinding.instance.scheduleFrame();
  }

  /// Sends the frames of the previews that changed.
  Future<void> _capture() async {
    if (_capturing) {
      _captureAgain = true;
      return;
    }
    final active = _active;
    if (active != null) _dirty.add(active);
    if (_dirty.isEmpty) return;
    final wait = _frameInterval - DateTime.now().difference(_lastCapture);
    _capturing = true;
    try {
      if (!wait.isNegative) await Future<void>.delayed(wait);
      final generation = _generation;
      final indexes = _dirty.toList();
      _dirty.clear();
      for (final index in indexes) {
        if (index >= _entries.length || generation != _generation) break;
        await _sendFrame(generation, index);
      }
      _lastCapture = DateTime.now();
    } finally {
      _capturing = false;
    }
    if (_captureAgain) {
      _captureAgain = false;
      SchedulerBinding.instance.scheduleFrame();
    }
  }

  Future<void> _sendFrame(int generation, int index) async {
    final box = _entries[index].key.currentContext?.findRenderObject();
    if (box is! RenderRepaintBoundary || !box.hasSize || box.size.isEmpty) {
      return;
    }
    if (box.debugNeedsPaint) {
      _dirty.add(index);
      return;
    }
    final image = await box.toImage(pixelRatio: _settings.pixelRatio);
    final png = await image.toByteData(format: ui.ImageByteFormat.png);
    image.dispose();
    if (png == null) return;
    final sizing = box.child;
    final header = ByteData(_frameHeaderBytes)
      ..setUint32(0, generation)
      ..setUint32(4, index)
      ..setFloat32(8, box.size.width)
      ..setFloat32(12, box.size.height)
      ..setUint32(16, sizing is _RenderPreviewBox ? sizing.flags : 0);
    _socket.add(
      Uint8List.fromList([
        ...header.buffer.asUint8List(),
        ...png.buffer.asUint8List(png.offsetInBytes, png.lengthInBytes),
      ]),
    );
  }

  /// Plays a pointer event FIDE forwarded onto its preview.
  void dispatchPointer(Map<String, Object?> message) {
    final index = message['index'] as int;
    if (index >= _entries.length) return;
    final box = _entries[index].key.currentContext?.findRenderObject();
    if (box is! RenderBox || !box.hasSize) return;
    final local = Offset(
      (message['x'] as num).toDouble(),
      (message['y'] as num).toDouble(),
    );
    final position = box.localToGlobal(local);
    _active = index;
    final gestures = GestureBinding.instance;
    switch (message['phase']) {
      case 'down':
        final pointer = _nextPointer++;
        _pointer = pointer;
        final result = BoxHitTestResult();
        box.hitTest(result, position: local);
        result.add(HitTestEntry(gestures));
        _hits[pointer] = result;
        gestures.dispatchEvent(
          PointerDownEvent(
            pointer: pointer,
            position: position,
            kind: PointerDeviceKind.mouse,
            buttons: kPrimaryButton,
          ),
          result,
        );
      case 'move':
        final pointer = _pointer;
        final result = _hits[pointer];
        if (pointer == null || result == null) return;
        gestures.dispatchEvent(
          PointerMoveEvent(
            pointer: pointer,
            position: position,
            kind: PointerDeviceKind.mouse,
            buttons: kPrimaryButton,
          ),
          result,
        );
      case 'up':
        final pointer = _pointer;
        final result = _hits.remove(pointer);
        _pointer = null;
        if (pointer == null || result == null) return;
        gestures.dispatchEvent(
          PointerUpEvent(
            pointer: pointer,
            position: position,
            kind: PointerDeviceKind.mouse,
          ),
          result,
        );
      case 'scroll':
        final result = BoxHitTestResult();
        box.hitTest(result, position: local);
        result.add(HitTestEntry(gestures));
        gestures.dispatchEvent(
          PointerScrollEvent(
            position: position,
            kind: PointerDeviceKind.mouse,
            scrollDelta: Offset(
              (message['dx'] as num?)?.toDouble() ?? 0,
              (message['dy'] as num?)?.toDouble() ?? 0,
            ),
          ),
          result,
        );
    }
    SchedulerBinding.instance.scheduleFrame();
  }

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      home: Stack(
        clipBehavior: Clip.none,
        children: [
          for (final (index, entry) in _entries.indexed)
            Positioned(
              left: 0,
              top: 0,
              child: _CaptureBoundary(
                key: entry.key,
                onPainted: () => _dirty.add(index),
                child: _buildPreview(entry),
              ),
            ),
        ],
      ),
    );
  }

  /// [entry]'s widget, sized and themed as its annotation says.
  Widget _buildPreview(_Entry entry) {
    final preview = entry.preview;
    final brightness =
        _settings.brightness ??
        preview.brightness ??
        _settings.fallbackBrightness;
    Widget child = Builder(
      builder: (context) {
        final built = entry.build();
        if (built is Widget) return built;
        if (built is WidgetBuilder) return built(context);
        throw FlutterError(
          '${entry.function} returns ${built.runtimeType}, '
          'not a Widget or WidgetBuilder',
        );
      },
    );
    final wrapper = preview.wrapper;
    if (wrapper != null) child = wrapper(child);
    final theme = preview.theme?.call();
    if (theme != null) {
      final themed = child;
      child = Builder(builder: (context) => theme.apply(context, themed));
    }
    final localizations = preview.localizations?.call();
    if (localizations != null) {
      child = Localizations(
        locale:
            localizations.locale ?? localizations.supportedLocales.first,
        delegates: [
          ...?localizations.localizationsDelegates,
          DefaultMaterialLocalizations.delegate,
          DefaultCupertinoLocalizations.delegate,
          DefaultWidgetsLocalizations.delegate,
        ],
        child: child,
      );
    }
    final codeWidth = _finite(preview.size?.width);
    final codeHeight = _finite(preview.size?.height);
    final id = entry.id;
    final width = _lengthOf(_widths, id, codeWidth);
    final height = _lengthOf(_heights, id, codeHeight);
    return _PreviewBox(
      width: width,
      height: height,
      sizeFlags:
          (width == codeWidth ? 0 : _widthIsAdjusted) |
          (height == codeHeight ? 0 : _heightIsAdjusted) |
          (width == null ? _widthIsAuto : 0) |
          (height == null ? _heightIsAuto : 0),
      maxWidth: _settings.maxWidth,
      maxHeight: _settings.maxHeight,
      fallbackHeight: _settings.fallbackHeight,
      child: Theme(
        data: ThemeData(brightness: brightness),
        child: Builder(
          builder: (context) => MediaQuery(
            data: MediaQuery.of(context).copyWith(
              platformBrightness: brightness,
              textScaler: preview.textScaleFactor == null
                  ? null
                  : TextScaler.linear(preview.textScaleFactor!),
            ),
            // Transparent, so the backdrop FIDE draws shows what the
            // preview leaves unpainted
            child: Material(type: MaterialType.transparency, child: child),
          ),
        ),
      ),
    );
  }
}

/// Sizes a preview deterministically: the width FIDE or its annotation
/// sets, else up to the panel's; the height FIDE or its annotation sets,
/// else the child's
/// natural height at that width (its max intrinsic height), so widgets that
/// expand, such as a Column or a stretched Row, don't fill whatever room
/// the host has; a child without a natural height (a scroll view, a
/// LayoutBuilder, a box that only expands) gets the fallback height.
class _PreviewBox extends SingleChildRenderObjectWidget {
  const _PreviewBox({
    required this.width,
    required this.height,
    required this.sizeFlags,
    required this.maxWidth,
    required this.maxHeight,
    required this.fallbackHeight,
    required super.child,
  });

  final double? width;
  final double? height;
  final int sizeFlags;
  final double maxWidth;
  final double maxHeight;
  final double fallbackHeight;

  @override
  RenderObject createRenderObject(BuildContext context) => _RenderPreviewBox()
    ..width = width
    ..height = height
    ..sizeFlags = sizeFlags
    ..maxWidth = maxWidth
    ..maxHeight = maxHeight
    ..fallbackHeight = fallbackHeight;

  @override
  void updateRenderObject(
    BuildContext context,
    _RenderPreviewBox renderObject,
  ) {
    renderObject
      ..width = width
      ..height = height
      ..sizeFlags = sizeFlags
      ..maxWidth = maxWidth
      ..maxHeight = maxHeight
      ..fallbackHeight = fallbackHeight
      ..markNeedsLayout();
  }
}

class _RenderPreviewBox extends RenderProxyBox {
  double? width;
  double? height;

  /// The flags telling who set [width] and [height]: FIDE, the
  /// annotation or no one (Auto).
  int sizeFlags = 0;
  double maxWidth = 0;
  double maxHeight = 0;
  double fallbackHeight = 0;

  /// How the last layout sized the preview: [sizeFlags], and
  /// [_widthFollowsPanel] and [_heightIsFallback] when they apply.
  int flags = 0;

  @override
  void performLayout() {
    flags = sizeFlags;
    final child = this.child;
    if (child == null) {
      size = constraints.smallest;
      return;
    }
    final fixedWidth = width;
    final layoutHeight = height ?? _naturalHeight(child, fixedWidth ?? maxWidth);
    child.layout(
      BoxConstraints(
        minWidth: fixedWidth ?? 0,
        maxWidth: fixedWidth ?? maxWidth,
        minHeight: height ?? 0,
        maxHeight: layoutHeight,
      ),
      parentUsesSize: true,
    );
    size = child.size;
    if (fixedWidth == null && size.width >= maxWidth - _fillTolerance) {
      flags |= _widthFollowsPanel;
    }
  }

  /// [child]'s max intrinsic height at [width], at most [maxHeight]; the
  /// fallback height when it has none.
  double _naturalHeight(RenderBox child, double width) {
    double natural;
    try {
      natural = child.getMaxIntrinsicHeight(width);
    } catch (_) {
      // Scroll views and LayoutBuilders can't tell their intrinsic size
      natural = 0;
    }
    if (!natural.isFinite || natural <= 0) {
      natural = fallbackHeight;
      flags |= _heightIsFallback;
    }
    return natural.clamp(0, maxHeight);
  }
}

/// A repaint boundary telling the host when it painted again.
class _CaptureBoundary extends SingleChildRenderObjectWidget {
  const _CaptureBoundary({
    super.key,
    required this.onPainted,
    required super.child,
  });

  final VoidCallback onPainted;

  @override
  RenderObject createRenderObject(BuildContext context) =>
      _RenderCaptureBoundary(onPainted);

  @override
  void updateRenderObject(
    BuildContext context,
    _RenderCaptureBoundary renderObject,
  ) {
    renderObject.onPainted = onPainted;
  }
}

class _RenderCaptureBoundary extends RenderRepaintBoundary {
  _RenderCaptureBoundary(this.onPainted);

  VoidCallback onPainted;

  @override
  void paint(PaintingContext context, Offset offset) {
    super.paint(context, offset);
    onPainted();
  }
}
